        }
      ],
      "explanation": "TfL requires private hire operators and drivers to report incidents and complaints within 72 hours",
      "id": "s-db-0005"
    },
    {
      "type": "multiple_choice",
      "question": "What is the maximum number of passengers a private hire vehicle (PHV) can carry?",
      "options": [
        "As stated on the vehicle licence",
        "Always 4",
        "Always 6",
        "As the driver decides"
      ],
      "correctAnswer": 0,
      "explanation": "The maximum number of passengers is set on the vehicle licence and must never be exceeded",
