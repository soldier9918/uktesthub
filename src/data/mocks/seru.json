      ],
      "explanation": "TfL defines ridesharing as separate fares paid by people who do not know each other travelling together in the same vehicle",
      "id": "s-db-0001"
    },
    {
      "type": "dropdown_blanks",
      "template": "As a private hire driver, you must {{0}} your PHV licence and {{1}} disc on the vehicle whenever you are working",
