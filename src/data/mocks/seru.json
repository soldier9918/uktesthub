        }
      ],
      "explanation": "Drivers must display their TfL PHV identification disc on the vehicle and carry their driver licence at all times when working",
      "id": "s-db-0002"
    },
    {
      "type": "dropdown_blanks",
      "template": "If a passenger has an assistance dog, you {{0}} refuse the booking and you {{1}} charge an extra fee for the dog",
      "prompt": "Select the correct words to complete the sentence",
      "blanks": [
        {
          "options": [
            "must not",
