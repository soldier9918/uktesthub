        },
        {
          "options": [
            "must not",
            "may",
            "should"
          ],
          "correctIndex": 0
        }
      ],
      "explanation": "Under the Equality Act 2010, refusing an assistance dog or charging extra is unlawful discrimination",
      "id": "s-db-0003"
    },
    {
      "type": "dropdown_blanks",
      "template": "As a driver, you may have to {{0}} children or adults who are at risk. You may come into {{1}} with passengers that are being trafficked, exploited or abused",
      "prompt": "Select the correct words to complete the sentence",
      "blanks": [
        {
          "options": [
            "transport",
